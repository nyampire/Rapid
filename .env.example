# OAuth2 client credentials for the OpenStreetMap connections used by
# index.html / dist/index.html. These are PUBLIC SPA credentials — they
# are visible in the deployed JavaScript and are not secret. The keys
# below are the values that ship in `facebook/Rapid` upstream and are
# safe defaults for local development.
#
# For production deployments, replace these with the values registered
# for that deployment in https://www.openstreetmap.org/oauth2/applications.
#
# Setup: cp .env.example .env (then edit if you have your own keys).

# Production OSM (api.openstreetmap.org)
OSM_CLIENT_ID=O3g0mOUuA2WY5Fs826j5tP260qR3DDX7cIIE2R2WWSc
OSM_CLIENT_SECRET=b4aeHD1cNeapPPQTrvpPoExqQRjybit6JBlNnxh62uE

# Dev OSM (api06.dev.openstreetmap.org)
OSM_DEV_CLIENT_ID=NShFpuCHSGxVMrttMR8cyYJ5I1pC-yEdNRHpX6XslGM
OSM_DEV_CLIENT_SECRET=YqAspFOYaTOv-uGM8TXbRLMXZUwgczdh3kUaPwqLPSQ
